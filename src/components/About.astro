---
import { site } from '../data/site';
import Skills from './Skills.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="about" class="mx-auto max-w-6xl scroll-mt-20 px-6 py-24">
  <SectionHeading eyebrow="The Wizard" title="About me" />

  <div class="reveal max-w-3xl space-y-5 text-lg text-muted">
    <p>{site.intro}</p>
    <p>{site.bio}</p>
  </div>

  <div class="mt-16">
    <p class="reveal mb-6 font-mono text-xs uppercase tracking-[0.3em] text-arcane">Tools I wield</p>
    <Skills />
  </div>
</section>
