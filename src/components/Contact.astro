---
import Socials from './Socials.astro';
---

<section id="contact" class="mx-auto max-w-6xl scroll-mt-20 px-6 py-24">
  <div class="reveal relative overflow-hidden rounded-3xl border border-edge bg-card/50 px-8 py-16 text-center glow-ring">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-arcane">Open the portal</p>
    <h2 class="mx-auto mt-4 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
      Let's talk AI, infrastructure, and shipping fast.
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-muted">
      Always up for a good conversation or a hard problem. You'll find me here:
    </p>

    <div class="mt-9 flex justify-center">
      <Socials size={28} />
    </div>
  </div>
</section>
