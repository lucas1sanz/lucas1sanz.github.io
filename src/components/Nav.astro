---
import { site } from '../data/site';

const links = [
  { href: '#projects', label: 'Work' },
  { href: '#about', label: 'About' },
  { href: '#process', label: 'The Magic' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-edge/60 bg-void/70 backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6" aria-label="Primary">
    <a href="#top" class="group flex items-center gap-2 font-semibold tracking-tight">
      <span class="text-arcane transition-transform group-hover:rotate-12" aria-hidden="true">✦</span>
      <span>{site.name}</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-7 text-sm text-muted md:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="transition-colors hover:text-ink focus-visible:text-ink">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile toggle (tiny inline-script island, no framework needed) -->
    <button
      id="nav-toggle"
      class="md:hidden text-ink"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <ul
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-edge/60 bg-void/95 px-6 py-3 text-sm md:hidden"
  >
    {
      links.map((l) => (
        <li>
          <a href={l.href} class="block rounded-lg px-2 py-2 text-muted hover:bg-card hover:text-ink" data-nav-link>
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const close = () => {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    };
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(open ? false : true));
    });
    menu.querySelectorAll('[data-nav-link]').forEach((a) => a.addEventListener('click', close));
  }
</script>
