---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article
  class:list={[
    'reveal group relative flex flex-col rounded-2xl border border-edge bg-card/60 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-arcane/60 hover:shadow-[0_0_50px_-20px_var(--color-arcane)]',
    project.featured && 'sm:col-span-2',
  ]}
>
  <div class="flex items-start justify-between">
    <span class="text-3xl text-arcane/80 transition-colors group-hover:text-arcane" aria-hidden="true">
      {project.sigil}
    </span>
    <div class="flex gap-3 text-faint">
      {
        project.repo && (
          <a href={project.repo} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} source`} class="transition-colors hover:text-ink">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12 11.5 11.5 0 0 0 8.36 23c.6.11.82-.26.82-.58v-2c-3.34.73-4.04-1.6-4.04-1.6-.55-1.39-1.34-1.76-1.34-1.76-1.1-.75.08-.73.08-.73 1.22.09 1.86 1.25 1.86 1.25 1.08 1.85 2.83 1.32 3.52 1 .11-.78.42-1.32.76-1.62-2.67-.3-5.47-1.34-5.47-5.95 0-1.32.47-2.39 1.25-3.23-.13-.3-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.88.12 3.18.78.84 1.25 1.91 1.25 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" /></svg>
          </a>
        )
      }
      {
        project.demo && (
          <a href={project.demo} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} live demo`} class="transition-colors hover:text-ink">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </a>
        )
      }
    </div>
  </div>

  <h3 class="mt-5 text-xl font-semibold tracking-tight">{project.title}</h3>
  <p class="mt-2 flex-1 text-muted">{project.blurb}</p>

  <ul class="mt-5 flex flex-wrap gap-2">
    {
      project.tags.map((tag) => (
        <li class="rounded-full border border-edge bg-abyss px-3 py-1 font-mono text-xs text-faint">
          {tag}
        </li>
      ))
    }
  </ul>
</article>
